{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "compaction": {
    "auto": false
  },
  "providers": {
    "pcc": {
      "name": "Apple PCC (local)",
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8791/v1"
      },
      "models": {
        "pcc": {
          "name": "Apple PCC",
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "reasoning": false,
          "tool_call": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "pcc-reasoning": {
          "name": "Apple PCC (moderate reasoning)",
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "reasoning": true,
          "tool_call": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "pcc-deep": {
          "name": "Apple PCC (deep reasoning)",
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "reasoning": true,
          "tool_call": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    },
