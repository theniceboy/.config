  "permissions": [
    {
      "action": "global_memory_write",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "board_board_add",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "board_board_edit",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "board_board_move",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "board_board_remove",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "board_board_migrate",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "/Users/david/base/.memory",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "/Users/david/base/.memory/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "/Users/david/base/.memory",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "/Users/david/base/.memory/*",
      "effect": "deny"
    }
  ],
  "mcp": {
    "servers": {
      "web": {
        "type": "remote",
        "url": "http://127.0.0.1:8775/searcher/mcp"
      },
      "zai-vision": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@z_ai/mcp-server@latest"
        ],
        "environment": {
          "Z_AI_API_KEY": "{env:ZAI_API_KEY}",
          "Z_AI_MODE": "ZAI"
        }
      },
      "rednote": {
        "type": "remote",
        "url": "http://127.0.0.1:8776/rednote-evidence/mcp",
        "disabled": true
      },
      "pinchtab": {
        "type": "local",
        "command": [
          "node",
          "/Users/david/.config/opencode/tool/pinchtab-mcp.mjs"
        ],
        "disabled": true
      },
      "sentry": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "mcp-remote@latest",
          "https://mcp.sentry.dev/mcp"
        ],
        "disabled": true
      },
      "google-maps": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@cablate/mcp-google-map",
          "--stdio"
        ],
        "disabled": true
      },
      "board": {
        "type": "local",
        "command": [
          "python3",
          "-B",
          "-u",
          "/Users/david/base/scripts/board-mcp.py",
          "serve"
        ]
      },
      "global_memory": {
        "type": "local",
        "command": [
          "python3",
          "-B",
          "-u",
          "/Users/david/base/scripts/memory-mcp.py",
          "serve",
          "global"
        ],
        "codemode": false
      },
      "repo_memory": {
        "type": "local",
        "command": [
          "python3",
          "-B",
          "-u",
          "/Users/david/base/scripts/memory-mcp.py",
          "serve",
          "repo"
        ],
        "codemode": false
      }
    }
  },
  "lsp": {
    "dart": {
      "command": [
        "dart",
        "language-server"
      ],
      "extensions": [
        ".dart"
      ]
    },
    "biome": {
      "disabled": true
    }
  },
  "agent": {
    "build": {
      "color": "#ff79c6"
    },
    "plan": {
      "color": "#8be9fd"
    },
    "explore": {
      "model": "cliproxy/gpt-5.6-luna(high)",
      "disabled": true
    }
  },
  "agents": {
    "plan": {
      "permissions": [
        { "action": "global_memory_write", "resource": "*", "effect": "deny" },
        { "action": "repo_memory_write", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
